{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake: configure (windows-msvc)",
      "type": "shell",
      "command": "cmake --preset windows-msvc",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "CMake: build (windows-msvc Release)",
      "type": "shell",
      "command": "cmake --build --preset windows-msvc",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "dependsOn": ["CMake: configure (windows-msvc)"],
      "problemMatcher": ["$msCompile"]
    },
    {
      "label": "CTest",
      "type": "shell",
      "command": "ctest --test-dir build/windows-msvc -C Release --output-on-failure",
      "dependsOn": ["CMake: build (windows-msvc Release)"],
      "problemMatcher": []
    }
  ]
}
